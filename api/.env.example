# Copy to .env (git-ignored) and fill in. Never commit real values.

# Local dev: a file path. Production: libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=freeman-dev.db
# Only needed for a remote Turso database (turso db tokens create <db>)
TURSO_AUTH_TOKEN=
# Signs login tokens. Required: while empty, every protected route answers 503. If set, it must be
# at least 32 characters or the server refuses to start. Generate e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional tuning (defaults shown)
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# Leave false in production; create accounts with `python -m scripts.create_user <email>`.
# ALLOW_REGISTRATION=false
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900
# Optional, comma-separated, only for the web build
CORS_ORIGINS=

# --- news analysis (server-side only; never in the app) ---
OPENAI_API_KEY=
# The model name is your choice; it must support structured outputs
OPENAI_MODEL=
# Free key from finnhub.io. Used for news and for market prices (POST /prices/refresh).
FINNHUB_API_KEY=
# Optional tuning (defaults shown)
# ANALYSIS_CACHE_HOURS=6
# ANALYSIS_REFRESH_MIN_MINUTES=15
# ANALYSIS_DAILY_CAP=30
# PRICE_CACHE_SECONDS=120
# QUOTE_TIMEOUT_SECONDS=5

# --- Price alerts by email ---
# Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it here (not your account password).
# Google shows the app password in groups with spaces: paste it WITHOUT the spaces (the server
# does not remove them). It is plain ASCII letters; a non-ASCII character in SMTP_PASSWORD is not supported.
# With SMTP_USER or SMTP_PASSWORD empty, or FINNHUB_API_KEY empty, price alerts stay off.
SMTP_USER=
SMTP_PASSWORD=
# Optional (defaults shown). SMTP_FROM defaults to SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=
# Minimum 10. The server refuses to start with a smaller value.
# ALERT_CHECK_SECONDS=120
# Minimum 60.
# ALERT_COOLDOWN_SECONDS=3600
