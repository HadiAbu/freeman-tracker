{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Catch the mistakes `strict` lets through: a class method that silently stops overriding its
    // base after a rename, a switch case that falls into the next one, a function that returns on
    // only some paths, and a parameter nobody reads.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
